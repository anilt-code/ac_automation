{
  "name": "asset-connect-playwright",
  "version": "1.0.0",
  "description": "Asset Connect login and OTP Playwright tests",
  "scripts": {
    "test": "playwright test",
    "test:login": "playwright test tests/auth/login.spec.ts",
    "test:login:headed": "playwright test tests/auth/login.spec.ts --headed",
    "test:login:watch": "playwright test tests/auth/login.spec.ts --headed --workers=1 --timeout=0",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "login"
  ],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
